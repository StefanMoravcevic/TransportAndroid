<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:name="com.programdoo.transport.App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icon_logo_wint"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/icon_logo_wint"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fitnes"
        tools:targetApi="31" >
        <activity
            android:name="com.programdoo.transport.ui.pages.login.LoginActivity"
            android:exported="true">
        </activity>
        <activity
            android:name="com.programdoo.transport.ui.pages.menu.MenuActivity"
            android:exported="true">
        </activity>
        <activity
            android:name="com.programdoo.transport.ui.pages.trainees.TraineesActivity"
            android:exported="false">
        </activity>
        <activity
            android:name="com.programdoo.transport.ui.pages.appointments.AppointmentsActivity"
            android:exported="false">
        </activity>
        <activity
            android:name="com.programdoo.transport.ui.pages.memberships.MembershipActivity"
            android:exported="false">
        </activity>
        <activity
            android:name="com.programdoo.transport.ui.pages.settings.SettingsActivity"
            android:exported="false">
        </activity>
        <activity
            android:name="com.programdoo.transport.ui.pages.menu.ClientMenuActivity"
            android:exported="false">
        </activity>
        <activity
            android:name="com.programdoo.transport.ui.pages.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.programdoo.transport.ui.pages.scannedpackages.ScannedPackageActivity"
            android:exported="false">
        </activity>
    </application>

</manifest>
