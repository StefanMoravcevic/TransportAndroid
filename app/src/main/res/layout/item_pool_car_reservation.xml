<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/primaryLighter">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- DRIVER -->
        <TextView
            android:id="@+id/tvDriver"
            style="@style/ProgramTextView.Regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:drawablePadding="4dp"
            app:drawableStartCompat="@drawable/icon_trainer_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvFrom"/>

        <!-- FROM -->
        <TextView
            android:id="@+id/tvFrom"
            style="@style/ProgramTextView.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- VEHICLE -->
        <TextView
            android:id="@+id/tvVehicle"
            style="@style/ProgramTextView.Regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:drawablePadding="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            app:drawableStartCompat="@drawable/icon_vehicle_small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDriver"
            app:layout_constraintEnd_toStartOf="@id/tvFrom"/>

        <!-- NOTE (MARQUEE) -->
        <TextView
            android:id="@+id/tvNote"
            style="@style/ProgramTextView.Regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:singleLine="true"
            android:scrollHorizontally="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvVehicle"
            app:layout_constraintEnd_toStartOf="@id/tvFrom"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- TO -->
        <TextView
            android:id="@+id/tvTo"
            style="@style/ProgramTextView.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:gravity="end"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFrom"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>