<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <HorizontalScrollView
        android:id="@+id/hsvChips"
        style="@style/ContainerChips"
        app:layout_constraintBottom_toTopOf="@+id/searchbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
     </HorizontalScrollView>

    <com.programdoo.transport.ui.views.ProgramSearchBar
        android:id="@+id/searchbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/primaryLightest"
        android:layout_marginHorizontal="@dimen/edgePad"
        android:layout_marginBottom="@dimen/edgePad"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/hsvChips"
        app:layout_constraintBottom_toTopOf="@id/scrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </com.programdoo.transport.ui.views.ProgramSearchBar>

    <ScrollView
        android:id="@+id/scrollView"
        style="@style/ContainerMain"
        app:layout_constraintTop_toBottomOf="@id/searchbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout style="@style/ContainerList">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView"
                style="@style/ProgramCardView" >

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvActivities"
                    style="@style/ContainerRecyclerView"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewActivity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:backgroundTint="?attr/colorPrimary"
        app:tint="?attr/colorOnPrimary"
        android:contentDescription="@string/label_add_activity"
        android:src="@drawable/icon_list_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>