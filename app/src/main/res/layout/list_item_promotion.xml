<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/root"
    style="@style/ListItem"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/edgePad">

    <TextView
        android:id="@+id/tvName"
        app:drawableStartCompat="@drawable/icon_tag_medium"
        style="@style/ProgramTextView.Regular"
        app:drawableTint="@color/tertiaryLighter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvFrom"/>

    <TextView
        android:id="@+id/tvFrom"
        android:paddingHorizontal="@dimen/listItemSmallTextPad"
        app:drawableStartCompat="@drawable/icon_date_range_small"
        style="@style/ProgramTextView.Small"
        app:drawableTint="@color/tertiaryLighter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvName"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tvEmpty"
        style="@style/ProgramTextView.End"
        android:text=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvTo"/>

    <TextView
        android:id="@+id/tvTo"
        android:paddingHorizontal="@dimen/listItemSmallTextPad"
        app:drawableEndCompat="@drawable/icon_date_range_small"
        style="@style/ProgramTextView.Small.End"
        app:drawableTint="@color/tertiaryLighter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEmpty"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>