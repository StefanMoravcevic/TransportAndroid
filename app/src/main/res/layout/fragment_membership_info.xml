<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="@dimen/edgePad">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="@style/ContainerMain"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ContainerItemVertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/ProgramCardView" >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/tvFullName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Full name"
                                android:textAppearance="?attr/textAppearanceHeadline6" />

                            <TextView
                                android:id="@+id/tvOrgUnit"
                                app:drawableStartCompat="@drawable/icon_org_unit_small"
                                style="@style/ProgramTextView.Small" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:layout_weight="3" >
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/ProgramCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ProgramCardView.Container">

                    <com.programdoo.transport.ui.views.ProgramCardViewInfoItemDouble
                        android:id="@+id/idMembershipInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:firstItemLabel="@string/label_membership_name"
                        app:secondItemLabel="@string/label_membership_type"
                        app:defaultText="@string/label_unknown">
                    </com.programdoo.transport.ui.views.ProgramCardViewInfoItemDouble>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerColor="@color/primaryLighter">
                    </com.google.android.material.divider.MaterialDivider>

                    <com.programdoo.transport.ui.views.ProgramCardViewInfoItemDouble
                        android:id="@+id/idValidFrom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:firstItemLabel="@string/label_membership_date_from"
                        app:secondItemLabel="@string/label_membership_date_to"
                        app:defaultText="@string/label_unknown">
                    </com.programdoo.transport.ui.views.ProgramCardViewInfoItemDouble>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerColor="@color/primaryLighter">
                    </com.google.android.material.divider.MaterialDivider>

                    <com.programdoo.transport.ui.views.ProgramCardViewInfoItem
                        android:id="@+id/idNumberOfAppointments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemLabel="@string/label_numberOfAppointments"
                        app:defaultText="@string/label_unknown">
                    </com.programdoo.transport.ui.views.ProgramCardViewInfoItem>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>