<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F6F8">

    <!-- MAIN UI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="Skenirajte paket"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:text="Učitavanje lokacije..."
            android:textColor="#FF9800"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etScanInput"
            android:layout_width="match_parent"
            android:layout_height="122dp"
            android:background="@drawable/bg_scan_input"
            android:hint="Skenirajte bar kod paketa"
            android:imeOptions="actionDone"
            android:inputType="textNoSuggestions"
            android:padding="14dp"
            android:singleLine="true"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- SUCCESS OVERLAY ICON -->
    <ImageView
        android:id="@+id/imgSuccess"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center"
        android:src="@drawable/icon_succesfully_saved"
        android:visibility="gone" />

</FrameLayout>