<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="@dimen/edgePad">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        style="@style/ContainerMain"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ContainerItemVertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/ProgramCardView" >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                android:id="@+id/tvFullName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Full name"
                                android:textAppearance="?attr/textAppearanceHeadline6" />

                            <TextView
                                android:id="@+id/tvPhoneNumber"
                                app:drawableStartCompat="@drawable/icon_phone_small"
                                style="@style/ProgramTextView.Small" />

                            <TextView
                                android:id="@+id/tvEmail"
                                app:drawableStartCompat="@drawable/icon_mail_small"
                                style="@style/ProgramTextView.Small" />

                            <TextView
                                android:id="@+id/tvOrgUnit"
                                app:drawableStartCompat="@drawable/icon_org_unit_small"
                                style="@style/ProgramTextView.Small" />

                            <TextView
                                android:id="@+id/tvHeight"
                                app:drawableStartCompat="@drawable/icon_measuring_tape_small"
                                style="@style/ProgramTextView.Small" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:layout_weight="3" >

                            <ImageView
                                android:id="@+id/imgProfilePicture"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/image_placeholder_profile_female" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/ProgramCardView">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ProgramCardView.Container">

                    <com.programdoo.transport.ui.views.ProgramCardViewInfoItemDouble
                        android:id="@+id/iidMembershipExpirySessionsLeft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:firstItemLabel="@string/label_membership_expiry_date"
                        app:secondItemLabel="@string/label_sessions_left"
                        app:defaultText="@string/label_unknown">
                    </com.programdoo.transport.ui.views.ProgramCardViewInfoItemDouble>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerColor="@color/primaryLighter">
                    </com.google.android.material.divider.MaterialDivider>

                    <com.programdoo.transport.ui.views.ProgramCardViewInfoItemDouble
                        android:id="@+id/iidTrialTrainerDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:firstItemLabel="@string/label_trial_trainer"
                        app:secondItemLabel="@string/label_trial_date"
                        app:defaultText="@string/label_unknown">
                    </com.programdoo.transport.ui.views.ProgramCardViewInfoItemDouble>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dividerColor="@color/primaryLighter">
                    </com.google.android.material.divider.MaterialDivider>

                    <com.programdoo.transport.ui.views.ProgramCardViewInfoItem
                        android:id="@+id/iiNextSessionDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemLabel="@string/label_next_session_date"
                        app:defaultText="@string/label_unknown">
                    </com.programdoo.transport.ui.views.ProgramCardViewInfoItem>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="36dp"
                android:layout_marginVertical="2dp"
                android:weightSum="4">
                <Button
                    android:id="@+id/bMemberships"
                    style="@style/ProgramButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_memberships"
                    android:layout_marginRight="4dp"
                    app:icon="@drawable/icon_membership_card"
                    android:layout_weight="4"/>

                <Button
                    android:id="@+id/bNewMembership"
                    style="@style/ProgramButton.Primary"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    app:icon="@drawable/icon_add" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="36dp"
                android:layout_marginVertical="2dp"
                android:weightSum="4">
                <Button
                    android:id="@+id/bMeasurements"
                    style="@style/ProgramButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_measurements"
                    android:layout_marginRight="4dp"
                    app:icon="@drawable/icon_measurements"
                    android:layout_weight="4"/>

                <Button
                    android:id="@+id/bNewMeasurement"
                    style="@style/ProgramButton.Primary"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    app:icon="@drawable/icon_add"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="36dp"
                android:layout_marginVertical="2dp"
                android:weightSum="4">
                <Button
                    android:id="@+id/bActivities"
                    style="@style/ProgramButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_activities"
                    android:layout_marginRight="4dp"
                    app:icon="@drawable/icon_activity"
                    android:layout_weight="4"/>

                <Button
                    android:id="@+id/bNewActivity"
                    style="@style/ProgramButton.Primary"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    app:icon="@drawable/icon_add"
                    />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>