<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounded_corners"
    android:paddingVertical="@dimen/edgePad">

    <LinearLayout
        android:id="@+id/llSearch"
        style="@style/ContainerSupport"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/scrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.programdoo.transport.ui.views.ProgramSearchBar
            android:id="@+id/searchbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/tertiaryLightest"
            app:expandedHintColor="@color/secondaryLighter">
        </com.programdoo.transport.ui.views.ProgramSearchBar>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        style="@style/ContainerMain"
        app:layout_constraintTop_toBottomOf="@+id/llSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout style="@style/ContainerList">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView"
                style="@style/ProgramCardView"
                app:cardBackgroundColor="@color/tertiaryLightest"
                app:strokeColor="@color/tertiaryLightest" >

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lvSelectItems"
                    style="@style/ContainerRecyclerView">
                </androidx.recyclerview.widget.RecyclerView>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>